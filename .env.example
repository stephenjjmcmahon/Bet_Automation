# Copy this file to `.env` and fill in the values. `.env` is gitignored — never commit it.

# ── Betfair ───────────────────────────────────────────────────────────────────
# Application key from https://developer.betfair.com (the "Delayed" key works for
# browsing; placing real bets needs a Live key).
BETFAIR_APP_KEY=
# Only needed if you want the login form pre-filled during development; the app
# normally takes credentials from the sign-in screen and never stores them.
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Used by gpt-4o (bet parsing) and gpt-4o-mini (event ranking, runner matching).
OPENAI_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required when APP_ENV=production — startup fails if it is unset or left at the
# development default.
SESSION_SECRET_KEY=

# "development" (default) or "production". Production enforces the secret above.
APP_ENV=development

# Comma-separated CORS allowlist. The frontend is served same-origin by this app,
# so the default is all you need. Never set this to "*".
ALLOWED_ORIGINS=http://localhost:8000

# Hard ceiling on a single stake, in GBP. Rejects any bet above it with a 422.
MAX_STAKE_GBP=100

# DEBUG | INFO | WARNING | ERROR. DEBUG prints the full parse/resolve trace.
LOG_LEVEL=INFO

# Per-IP rate limits. The AI limit covers /api/query and /api/prepare, which call
# OpenAI on every request.
AI_RATE_LIMIT=30/minute
LOGIN_RATE_LIMIT=10/minute
